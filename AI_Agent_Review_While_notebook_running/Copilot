# consensus_accept.py
import pandas as pd
df = pd.read_json("runs/all_results.jsonl", lines=True)  # or your results glob merged
# require at least 60% of reps with p > 0.5
threshold_p = 0.5
consensus_frac = 0.6
agg = df.groupby(["task_id","sample_id"])["p"].agg(list).reset_index()
def accept(ps):
    ps = [float(x) for x in ps if x is not None]
    if len(ps)==0: return False
    return (sum(1 for v in ps if v>threshold_p) / len(ps)) >= consensus_frac
agg["accepted"] = agg["p"].apply(accept)
accepted = agg[agg["accepted"]]
accepted.to_csv("accepted_resolves.csv", index=False)
print("Accepted resolves:", len(accepted))
Why: prevents low‑confidence one‑offs from counting as solved.

