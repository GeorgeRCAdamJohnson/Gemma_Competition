{
 "_comment": "Code-owned DEFAULT lever lexicon (lv-1). Used only when kb/curated/lever_lexicon.json is absent; proposed for curation in curated/_proposed_updates.md. kind: config (diff of a config field), tools (set diff of config.tools), prompt (presence of prompt_regex in the run's prompt text flips), dev-harness (dev_harness field vs the scorer), log (no config field: log mentions only). log_aliases are case-insensitive regexes unless case_sensitive is true.",
 "version": "lv-1",
 "levers": [
  {"id": "max_tool_calls", "label": "tool-call budget (max_tool_calls)", "kind": "config", "config_field": "max_tool_calls",
   "log_aliases": ["\\bmax_tool_calls\\b", "\\btool[- ]call budget\\b", "\\bcall (?:budget|cap)\\b", "\\bbudget raise\\b"]},
  {"id": "max_time_minutes", "label": "per-task time cap (max_time_minutes)", "kind": "config", "config_field": "max_time_minutes",
   "log_aliases": ["\\bmax_time_minutes\\b", "\\bmin/task\\b", "\\bper-task (?:time )?cap\\b"]},
  {"id": "max_turns", "label": "turn cap (max_turns)", "kind": "config", "config_field": "max_turns",
   "log_aliases": ["\\bmax_turns\\b", "\\bturn cap\\b"]},
  {"id": "timeout_seconds", "label": "tool timeout (timeout_seconds)", "kind": "config", "config_field": "timeout_seconds",
   "log_aliases": ["\\btimeout_seconds\\b", "\\b\\d+ ?s timeout\\b"]},
  {"id": "thinking_budget", "label": "thinking budget", "kind": "config", "config_field": "thinking_budget",
   "log_aliases": ["\\bthinking[_ ]budget\\b", "\\bthinking (?:ON|OFF|\\d+)\\b"]},
  {"id": "temperature", "label": "sampling temperature", "kind": "config", "config_field": "temperature",
   "log_aliases": ["\\btemperature\\b", "\\btemp ?[01]\\.\\d\\b", "\\btemp1\\b", "\\btemp0\\b"]},
  {"id": "top_k", "label": "sampling top_k", "kind": "config", "config_field": "top_k",
   "log_aliases": ["\\btop_k\\b", "\\btop-k\\b"]},
  {"id": "top_p", "label": "sampling top_p", "kind": "config", "config_field": "top_p",
   "log_aliases": ["\\btop_p\\b", "\\btop-p\\b"]},
  {"id": "max_output_tokens", "label": "max output tokens", "kind": "config", "config_field": "max_output_tokens",
   "log_aliases": ["\\bmax_output_tokens\\b", "\\bmax_out\\w*\\b", "\\bmaxout\\d*k?\\b"]},
  {"id": "frequency_penalty", "label": "frequency penalty", "kind": "log", "config_field": null,
   "log_aliases": ["\\bfreq\\w*[_ ]penalty\\b", "\\bfp0\\.\\d\\b"]},
  {"id": "tools", "label": "tool surface (config.tools)", "kind": "tools", "config_field": "tools",
   "log_aliases": ["\\btool[- ]surface\\b", "\\b\\d+-tool\\b", "\\bcode-intelligence tools\\b", "\\bget_code_neighbors\\b", "\\bget_code_subgraph\\b", "\\bsearch_similar_code\\b"]},
  {"id": "subagents-router", "label": "sub-agents / router", "kind": "log", "config_field": null,
   "log_aliases": ["\\bsub-?agents?\\b", "\\brouter\\b", "\\bSequentialAgent\\b", "\\bParallelAgent\\b", "\\bAgentTool\\b"]},
  {"id": "adapter-lora", "label": "adapter / LoRA", "kind": "config", "config_field": "adapter",
   "log_aliases": ["\\bLoRA\\b", "\\badapters?\\b"]},
  {"id": "model-size", "label": "model size (31B/12B/E4B/E2B)", "kind": "config", "config_field": "model",
   "log_aliases": ["\\bmodel[- ]size\\b", "\\bsize ladder\\b", "\\bsize-(?:e2b|e4b|12b)\\b"]},
  {"id": "prompt-text", "label": "prompt text changed (prompt_sha256)", "kind": "config", "config_field": "prompt_sha256",
   "log_aliases": ["\\bsystem prompt\\b", "\\bprompt (?:change|edit|rule|arm)s?\\b"]},
  {"id": "prompt-anchor-grep", "label": "prompt rule: pre-edit anchor grep", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)grep your anchor", "(?i)before the edit: grep"],
   "log_aliases": ["\\banchor[- ]grep\\b", "\\bgrep (?:your|the) anchor\\b"]},
  {"id": "prompt-delimiter-fix", "label": "prompt rule: edit_file delimiter fix", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)closing delimiter", "<\\|\"\\|> delimiter"],
   "log_aliases": ["\\bdelimiter\\b", "\\b_delim\\b"]},
  {"id": "prompt-apply-as-you-go", "label": "prompt rule: apply each change as you go", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)apply each the moment you locate it", "(?i)apply[- ]as[- ]you[- ]go"],
   "log_aliases": ["\\bapply[- ]as[- ]you[- ]go\\b", "\\bapply each\\b"]},
  {"id": "prompt-locate-numeral", "label": "prompt rule: numeric locate cap", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)at most \\d+(?:-\\d+)? tool calls locating"],
   "log_aliases": ["\\blocate[- _]numeral\\b", "\\bnumeral\\b"]},
  {"id": "prompt-verify-rule", "label": "prompt rule: verify before submit", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)\\bverify\\b"],
   "log_aliases": ["\\bverify[- ]rule\\b", "\\bP3_verify\\b"]},
  {"id": "prompt-compliance-salience", "label": "prompt rule: contract / compliance salience", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)exact contract", "(?i)INPUT VARIANTS"],
   "log_aliases": ["\\bcompliance\\b", "\\bsalience\\b", "\\bcontract[- ]anchoring\\b"]},
  {"id": "prompt-patch-size", "label": "prompt rule: patch_size check", "kind": "prompt", "config_field": null,
   "prompt_regex": ["(?i)\\bpatch_size\\b"],
   "log_aliases": ["\\bpatch_?size\\b"]},
  {"id": "prompt-one-to-1", "label": "prompt rule: ONE -> 1 numerals", "kind": "prompt", "config_field": null, "case_sensitive": true,
   "prompt_regex": ["\\bONE\\b"],
   "log_aliases": ["\\bONE\\s*(?:->|\u2192)\\s*1\\b", "\\ball1s\\b"]},
  {"id": "dev-harness-compaction", "label": "dev harness EventsCompactionConfig.compaction_interval vs scorer", "kind": "dev-harness", "config_field": "compaction_interval",
   "log_aliases": ["\\bcompaction_interval\\b", "\\bcompaction\\b"]}
 ]
}
