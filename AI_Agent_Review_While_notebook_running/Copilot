# Paste this into your Kaggle notebook (or local env) and run.
# Assumptions: runs/*.results.jsonl contains one JSON per run with fields:
#   - run_id, rep_id, task_id, sample_id, p (probability), resolved (0/1), timestamp, notes...
# .pinned.jsonl may contain aggregated per-run summaries.
# kb/replays/goldgate_all.json is the holdout/gold validity cache (optional).
# val_snapshot.parquet or val_hard_snapshot.parquet may exist for sample metadata.

import json, glob, os, math
from collections import defaultdict, Counter
import pandas as pd
import numpy as np
from pathlib import Path

# --- Config ---
RESULTS_GLOB = "runs/*.results.jsonl"
PINNED_GLOB = "runs/*.pinned.jsonl"
GOLD_PATH = "kb/replays/goldgate_all.json"
VAL_SNAPSHOT = "val_snapshot.parquet"
HARD_SNAPSHOT = "val_hard_snapshot.parquet"
ALERT_OUT = "agent_analysis_alerts.txt"
SUMMARY_CSV = "agent_task_summary.csv"

# --- Helpers ---
def read_jsonl(path):
    rows = []
    if not os.path.exists(path):
        return rows
    with open(path, "r") as f:
        for line in f:
            line=line.strip()
            if not line: continue
            try:
                rows.append(json.loads(line))
            except Exception:
                # tolerate trailing commas or bad lines
                try:
                    rows.append(json.loads(line.rstrip(",")))
                except Exception:
                    pass
    return rows

def load_all_results(glob_pat=RESULTS_GLOB):
    files = sorted(glob.glob(glob_pat))
    rows=[]
    for fn in files:
        rows.extend(read_jsonl(fn))
    return pd.DataFrame(rows)

# --- Load data ---
df = load_all_results(RESULTS_GLOB)
pinned = []
for fn in sorted(glob.glob(PINNED_GLOB)):
    pinned.extend(read_jsonl(fn))
pinned_df = pd.DataFrame(pinned) if pinned else pd.DataFrame()

gold = None
if os.path.exists(GOLD_PATH):
    try:
        with open(GOLD_PATH,"r") as f:
            gold = json.load(f)
    except Exception:
        gold = None

val_df = None
if os.path.exists(VAL_SNAPSHOT):
    try:
        val_df = pd.read_parquet(VAL_SNAPSHOT)
    except Exception:
        val_df = None

hard_df = None
if os.path.exists(HARD_SNAPSHOT):
    try:
        hard_df = pd.read_parquet(HARD_SNAPSHOT)
    except Exception:
        hard_df = None

# Quick sanity
print(f"Loaded results rows: {len(df)}  pinned rows: {len(pinned_df)}  gold: {bool(gold)}  val_snapshot: {bool(val_df)}  hard_snapshot: {bool(hard_df)}")

# --- Normalize expected columns ---
# Expect columns: run_id, rep_id, task_id, sample_id, p, resolved (0/1)
for c in ["run_id","rep_id","task_id","sample_id","p","resolved"]:
    if c not in df.columns:
        df[c] = np.nan

# Cast types
df["p"] = pd.to_numeric(df["p"], errors="coerce")
df["resolved"] = pd.to_numeric(df["resolved"], errors="coerce").fillna(0).astype(int)

# --- Per-task p distribution and basic stats ---
task_stats = []
for task, g in df.groupby("task_id"):
    ps = g["p"].dropna()
    resolved_rate = g["resolved"].mean() if len(g)>0 else np.nan
    task_stats.append({
        "task_id": task,
        "n_records": len(g),
        "n_unique_samples": g["sample_id"].nunique(),
        "p_mean": float(ps.mean()) if len(ps)>0 else np.nan,
        "p_std": float(ps.std()) if len(ps)>0 else np.nan,
        "p_10": float(ps.quantile(0.10)) if len(ps)>0 else np.nan,
        "p_50": float(ps.quantile(0.50)) if len(ps)>0 else np.nan,
        "p_90": float(ps.quantile(0.90)) if len(ps)>0 else np.nan,
        "resolved_rate": float(resolved_rate)
    })
task_stats_df = pd.DataFrame(task_stats).sort_values(["p_mean"], ascending=False)
task_stats_df.to_csv(SUMMARY_CSV, index=False)

# --- Calibration per task (ECE) ---
def compute_ece(probs, labels, n_bins=10):
    # Expected Calibration Error (simple)
    probs = np.asarray(probs)
    labels = np.asarray(labels)
    mask = ~np.isnan(probs)
    probs = probs[mask]; labels = labels[mask]
    if len(probs)==0:
        return np.nan
    bins = np.linspace(0.0,1.0,n_bins+1)
    ece = 0.0
    for i in range(n_bins):
        lo, hi = bins[i], bins[i+1]
        idx = (probs >= lo) & (probs < hi) if i < n_bins-1 else (probs >= lo) & (probs <= hi)
        if idx.sum()==0: continue
        acc = labels[idx].mean()
        conf = probs[idx].mean()
        ece += (idx.sum()/len(probs)) * abs(acc - conf)
    return float(ece)

cal_rows=[]
for task, g in df.groupby("task_id"):
    ece = compute_ece(g["p"].values, g["resolved"].values, n_bins=10)
    cal_rows.append({"task_id":task, "ece":ece, "n":len(g)})
cal_df = pd.DataFrame(cal_rows).sort_values("ece", ascending=False)

# --- Instability / variance across reps ---
# For each task, compute per-sample p variance across reps and per-task p variance across reps
inst_rows=[]
for task, g in df.groupby("task_id"):
    # per-sample variance
    sample_var = g.groupby("sample_id")["p"].agg(lambda x: float(np.nanvar(x)))
    mean_sample_var = float(sample_var.mean()) if len(sample_var)>0 else np.nan
    # per-rep mean p variance
    rep_mean = g.groupby("rep_id")["p"].mean()
    rep_var = float(np.nanvar(rep_mean)) if len(rep_mean)>0 else np.nan
    inst_rows.append({"task_id":task, "mean_sample_p_var":mean_sample_var, "rep_mean_p_var":rep_var, "n_reps": g["rep_id"].nunique()})
inst_df = pd.DataFrame(inst_rows).sort_values("rep_mean_p_var", ascending=False)

# --- Forgetting / flip events across reps per sample ---
# Build timeline per sample: sorted by rep_id or timestamp, track resolved state flips
flip_counts = defaultdict(int)
flip_examples = {}
for sample, g in df.sort_values(["sample_id","rep_id"]).groupby("sample_id"):
    seq = list(g["resolved"].astype(int).values)
    flips = sum(1 for i in range(1,len(seq)) if seq[i] != seq[i-1])
    if flips>0:
        flip_counts[sample] = flips
        flip_examples[sample] = {"flips":flips, "first_seq": seq[:5], "task_ids": list(g["task_id"].unique())}

flip_series = pd.Series(flip_counts).sort_values(ascending=False)
top_flips = flip_series.head(200)

# --- Alerts and prioritized list ---
alerts=[]
# 1) Tasks with low mean p but nonzero resolved_rate (unstable solves)
low_p_but_resolved = task_stats_df[(task_stats_df["p_mean"] < 0.35) & (task_stats_df["resolved_rate"] > 0.0)]
if not low_p_but_resolved.empty:
    alerts.append(("low_p_but_resolved", low_p_but_resolved[["task_id","p_mean","resolved_rate","n_records"]].to_dict(orient="records")))

# 2) High calibration error tasks
high_ece = cal_df[cal_df["ece"] > 0.08]  # threshold tunable
if not high_ece.empty:
    alerts.append(("high_calibration_error", high_ece.head(20).to_dict(orient="records")))

# 3) High rep variance tasks
high_rep_var = inst_df[inst_df["rep_mean_p_var"] > 0.01]  # tunable
if not high_rep_var.empty:
    alerts.append(("high_rep_variance", high_rep_var.head(20).to_dict(orient="records")))

# 4) Many flips (forgetting)
if len(top_flips) > 0:
    alerts.append(("top_forgetting_samples", [{"sample_id":int(s),"flips":int(v),"task_ids":flip_examples[s]["task_ids"]} for s,v in top_flips.head(50).items()]))

# 5) Sparse evidence tasks (few records)
sparse = task_stats_df[task_stats_df["n_records"] < 10]
if not sparse.empty:
    alerts.append(("sparse_tasks", sparse[["task_id","n_records"]].to_dict(orient="records")))

# Write alerts
with open(ALERT_OUT,"w") as f:
    json.dump({"alerts":alerts, "task_stats": task_stats_df.head(200).to_dict(orient="records")}, f, indent=2)

print("Alerts written to", ALERT_OUT)
print("Top alerts summary:")
for a in alerts:
    print(" -", a[0], "count:", len(a[1]) if isinstance(a[1], list) else 1)

# Save summary tables for inspection
task_stats_df.head(200).to_csv("task_stats_head.csv", index=False)
cal_df.to_csv("task_calibration.csv", index=False)
inst_df.to_csv("task_instability.csv", index=False)

# Print top 10 tasks by p_mean and top 10 by ece for quick glance
print("\nTop 10 tasks by p_mean:")
print(task_stats_df[["task_id","p_mean","p_std","resolved_rate","n_records"]].head(10).to_string(index=False))
print("\nTop 10 tasks by ECE (worst calibrated):")
print(cal_df.head(10).to_string(index=False))

# Save a compact human-readable alert file
with open("agent_alerts_human.txt","w") as f:
    for tag, payload in alerts:
        f.write(f"ALERT: {tag}\\n")
        f.write(json.dumps(payload, indent=2) + "\\n\\n")

print("Done. Files: task_stats_head.csv, task_calibration.csv, task_instability.csv, agent_alerts_human.txt")
How to interpret the main alerts (rules of thumb)
low_p_but_resolved — tasks where mean reported p is low (e.g., ~0.2–0.35) but some reps resolved them. This indicates fragile resolves: the agent sometimes resolves but with low confidence. Action: prioritize more reps for those tasks, or add targeted heuristics/filters to raise confidence threshold before marking resolved.

high_calibration_error (ECE) — model/agent probabilities are miscalibrated for that task. Action: apply simple recalibration (temperature scaling) on a held-out validation of reps, or require higher consensus across reps before accepting a resolve.

high_rep_variance — mean p shifts across reps; suggests instability in the agent policy or environment nondeterminism. Action: increase rep count, add deterministic seeds to the harness, or identify which rep variants (tooling, prompt) cause shifts.

top_forgetting_samples — specific sample IDs that flip resolved/unresolved across reps. Action: surface these to human reviewers for relabeling or to create targeted augmentations; they are high‑value manual checks.

sparse_tasks — tasks with too few observations to be reliable. Action: deprioritize automated resolves; route to human review or increase sampling.

