# weighted_consensus.py
import pandas as pd, numpy as np
df = pd.read_json("runs/all_results.jsonl", lines=True)
rep_reliability = df.groupby("rep_id").apply(lambda g: np.corrcoef(g["p"].fillna(0), g["resolved"].fillna(0))[0,1] if len(g)>10 else 0).fillna(0)
rep_reliability = rep_reliability.clip(lower=0)  # negative -> 0
def weighted_accept(group):
    # group is all rows for a sample
    weights = group["rep_id"].map(rep_reliability).values
    probs = group["p"].fillna(0).values
    if weights.sum()==0: return False
    score = (weights * (probs>0.5)).sum() / weights.sum()
    return score >= 0.6
accepted = df.groupby(["task_id","sample_id"]).apply(lambda g: weighted_accept(g)).reset_index(name="accepted")
accepted.to_csv("accepted_weighted.csv", index=False)
print("Weighted consensus done")
Why: leverages historical rep quality to reduce noise.

