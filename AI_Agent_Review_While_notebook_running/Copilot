# temp_scale.py
import numpy as np, pandas as pd
from scipy.optimize import minimize

df = pd.read_json("runs/all_results.jsonl", lines=True)
# use last rep per sample as calibration set or split by rep_id
cal_df = df[df["rep_id"].isin(df["rep_id"].unique()[-3:])]  # last 3 reps as calibration
out = []
for task, g in cal_df.groupby("task_id"):
    probs = g["p"].values
    labels = g["resolved"].values
    if len(probs) < 50:  # skip tiny tasks
        continue
    def nll(T):
        T = max(1e-6, T[0])
        p = 1/(1+np.exp(-np.log(probs/(1-probs))/T))
        # avoid log 0
        p = np.clip(p,1e-6,1-1e-6)
        return -np.mean(labels*np.log(p) + (1-labels)*np.log(1-p))
    res = minimize(nll, x0=[1.0], bounds=[(1e-6,10.0)])
    out.append({"task_id":task, "T":float(res.x[0])})
pd.DataFrame(out).to_csv("task_temperatures.csv", index=False)
print("Saved task_temperatures.csv")
# Apply T when computing consensus: p_cal = sigmoid(logit(p)/T)
Why: calibrated probabilities make consensus thresholds meaningful.

