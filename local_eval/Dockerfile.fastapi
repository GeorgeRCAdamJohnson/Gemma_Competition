# fastapi test surface, layered on the base verify image.
# Derived from fastapi's own requirements-tests.txt (present at the older task
# commits, absent at the newer ones) plus the pyproject "all" extras.
FROM gemma-verify:latest

RUN pip install --no-cache-dir \
      "anyio[trio]>=4.2,<4.7" \
      "httpx>=0.23.0,<1.0.0" \
      "python-multipart>=0.0.18" \
      "email-validator>=2.0.0" \
      "jinja2>=3.1.5" \
      "pydantic-settings>=2.0.0" \
      "pydantic-extra-types>=2.0.0" \
      "uvicorn[standard]>=0.12.0" \
      "dirty-equals>=0.9.0" \
      "sqlmodel>=0.0.27" \
      "flask>=1.1.2,<4.0.0" \
      "anyio[trio]>=3.2.1,<5.0.0" \
      "PyJWT>=2.9.0" \
      "pyyaml>=5.3.1,<7.0.0" \
      "pwdlib[argon2]>=0.2.1" \
      "inline-snapshot>=0.21.1" \
      "orjson" "ujson" "respx" "aiofiles"
