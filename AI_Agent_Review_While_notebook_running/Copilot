# Monitoring helper for Kaggle notebooks
# Paste this cell near the top of your notebook.
# Usage:
# 1) import and call start_monitor(metrics_path="metrics.json", interval=20, error_analysis_fn=your_fn)
# 2) In your training loop call report_metrics(...) after each epoch/validation.

import threading, time, json, csv, os, math
from datetime import datetime
from collections import deque
import numpy as np
import pandas as pd

# --- Configurable thresholds (tune as needed) ---
_STALL_EPOCHS = 5            # epochs with no val improvement => alert
_STALL_DELTA = 1e-4          # minimal improvement considered meaningful
_OVERFIT_GAP = 0.08          # train-val gap fraction to flag overfitting
_MIN_REPORT_INTERVAL = 5     # seconds between printed updates

# --- Internal state ---
_monitor_thread = None
_stop_flag = threading.Event()

def _safe_read_json(path):
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception:
        return None

def report_metrics(metrics_path,
                   epoch=None,
                   train_loss=None,
                   val_loss=None,
                   train_metric=None,
                   val_metric=None,
                   per_task=None,
                   extra=None):
    """
    Call this from your training loop to write a metrics snapshot.
    - per_task: dict of {task_name: metric_value}
    - extra: optional dict for any other info
    """
    payload = {
        "ts": datetime.utcnow().isoformat(),
        "epoch": epoch,
        "train_loss": float(train_loss) if train_loss is not None else None,
        "val_loss": float(val_loss) if val_loss is not None else None,
        "train_metric": float(train_metric) if train_metric is not None else None,
        "val_metric": float(val_metric) if val_metric is not None else None,
        "per_task": per_task or {},
        "extra": extra or {}
    }
    tmp = metrics_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, metrics_path)

def _append_run_log(csv_path, row):
    header = ["ts","epoch","train_loss","val_loss","train_metric","val_metric","notes"]
    exists = os.path.exists(csv_path)
    with open(csv_path, "a", newline="") as f:
        writer = csv.writer(f)
        if not exists:
            writer.writerow(header)
        writer.writerow([row.get(h,"") for h in header])

def _short(s, n=80):
    s = str(s)
    return s if len(s)<=n else s[:n-1]+"…"

def _monitor_loop(metrics_path, interval, csv_log, error_analysis_fn):
    history = deque(maxlen=200)
    best_val = None
    best_epoch = None
    last_print = 0
    stall_counter = 0
    while not _stop_flag.is_set():
        data = _safe_read_json(metrics_path)
        if data:
            history.append(data)
            epoch = data.get("epoch")
            train_loss = data.get("train_loss")
            val_loss = data.get("val_loss")
            train_metric = data.get("train_metric")
            val_metric = data.get("val_metric")
            per_task = data.get("per_task", {})
            ts = data.get("ts")
            # Update best and stall detection
            if val_metric is not None:
                if best_val is None or val_metric > best_val + _STALL_DELTA:
                    best_val = val_metric
                    best_epoch = epoch
                    stall_counter = 0
                else:
                    stall_counter += 1
            # Overfit detection
            overfit_flag = False
            if train_metric is not None and val_metric is not None:
                gap = (train_metric - val_metric)
                if gap > _OVERFIT_GAP:
                    overfit_flag = True
            # Compose concise status
            now = time.time()
            if now - last_print >= _MIN_REPORT_INTERVAL:
                last_print = now
                lines = []
                lines.append(f"[Monitor {datetime.utcnow().isoformat()}] epoch={epoch}  val_metric={_short(val_metric,8)}  train_metric={_short(train_metric,8)}")
                if best_epoch is not None:
                    lines.append(f"  best_val={_short(best_val,8)} @ epoch {best_epoch}")
                if stall_counter >= _STALL_EPOCHS:
                    lines.append(f"  ALERT: no val improvement for {stall_counter} reports (>= {_STALL_EPOCHS})")
                if overfit_flag:
                    lines.append(f"  ALERT: possible overfitting (train-val gap={gap:.3f})")
                if per_task:
                    # show up to 5 worst tasks
                    sorted_tasks = sorted(per_task.items(), key=lambda x: x[1])
                    worst = sorted_tasks[:5]
                    lines.append("  per_task worst: " + ", ".join([f\"{k}:{v:.3f}\" for k,v in worst]))
                print("\\n".join(lines))
                # Append to CSV log
                _append_run_log(csv_log, {
                    "ts": ts,
                    "epoch": epoch,
                    "train_loss": train_loss,
                    "val_loss": val_loss,
                    "train_metric": train_metric,
                    "val_metric": val_metric,
                    "notes": ("overfit" if overfit_flag else "") + (" stalled" if stall_counter>=_STALL_EPOCHS else "")
                })
                # If stalled or overfitting, run error analysis if available
                if (stall_counter >= _STALL_EPOCHS or overfit_flag) and error_analysis_fn is not None:
                    try:
                        print("  Running targeted error analysis (brief)...")
                        summary = error_analysis_fn()
                        # error_analysis_fn should return a short dict or string
                        if isinstance(summary, dict):
                            for k,v in summary.items():
                                print(f"    {k}: {_short(v,120)}")
                        else:
                            print("    " + _short(summary,400))
                    except Exception as e:
                        print(f"    error-analysis failed: {e}")
        time.sleep(interval)

def start_monitor(metrics_path="metrics.json",
                  interval=20,
                  csv_log="run_log.csv",
                  error_analysis_fn=None):
    """
    Start background monitor thread.
    - metrics_path: file your training loop writes via report_metrics(...)
    - interval: seconds between polls
    - csv_log: path to append run summaries
    - error_analysis_fn: optional callable that returns a short summary dict/string when called
    """
    global _monitor_thread, _stop_flag
    _stop_flag.clear()
    if _monitor_thread and _monitor_thread.is_alive():
        print("Monitor already running.")
        return
    _monitor_thread = threading.Thread(target=_monitor_loop, args=(metrics_path, interval, csv_log, error_analysis_fn), daemon=True)
    _monitor_thread.start()
    print(f"Monitor started (polling {metrics_path} every {interval}s).")

def stop_monitor():
    _stop_flag.set()
    print("Monitor stopping...")

# --- Example minimal error_analysis_fn you can adapt ---
def example_error_analysis():
    # This is a placeholder. Replace with a function that:
    # - loads latest val preds and labels
    # - returns a short dict: {"fail_count": N, "top_issue": "missing_feature_x", "sample": "id=123 ..."}
    try:
        # Example: look for a file 'val_snapshot.parquet' with columns ['id','y_true','y_pred',...]
        if not os.path.exists("val_snapshot.parquet"):
            return {"note":"no val_snapshot.parquet found"}
        df = pd.read_parquet("val_snapshot.parquet")
        df["err"] = (df["y_true"] != df["y_pred"]).astype(int)
        fails = df[df["err"]==1]
        if len(fails)==0:
            return {"fail_count":0}
        # simple heuristic: which column differs most between fails and successes
        cols = [c for c in df.columns if c not in ("id","y_true","y_pred","err")]
        diffs = {}
        for c in cols[:10]:
            try:
                diffs[c] = float(abs(fails[c].mean() - df[df["err"]==0][c].mean()))
            except Exception:
                diffs[c] = 0.0
        top = sorted(diffs.items(), key=lambda x: -x[1])[:3]
        sample = fails.head(1).to_dict(orient="records")[0]
        return {"fail_count": len(fails), "top_feature_shifts": top, "sample": sample}
    except Exception as e:
        return {"error": str(e)}
